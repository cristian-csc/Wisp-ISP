# WISP-ISP — plantilla de configuración.
#
# Copia este archivo a `.env` y rellena los valores reales. El `.env` NUNCA
# se sube a Git (está en .gitignore). Aquí no debe haber ningún valor real:
# ni contraseñas, ni tokens, ni IPs, ni usuarios del servidor.
#
# Procedimientos paso a paso: MANUAL_PRIVADO_SEGURIDAD_WISP-ISP.md

# ── Entorno ───────────────────────────────────────────────────────────────────
# "desarrollo" o "produccion".
# En produccion el backend SE NIEGA A ARRANCAR si SECRET_KEY o DATABASE_URL
# siguen con el valor de ejemplo, y esconde la documentación de la API (/docs).
ENTORNO=desarrollo

# ── Base de datos ─────────────────────────────────────────────────────────────
# POSTGRES_* los usa el contenedor postgres; DATABASE_URL lo usa el backend.
# La contraseña debe ser LA MISMA en los dos sitios, o el backend no conecta.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://USUARIO:CONTRASENA@127.0.0.1:5432/BASE

# ── Autenticación JWT ─────────────────────────────────────────────────────────
# Genera la clave con:  openssl rand -hex 32
# Si cambia, todas las sesiones abiertas se cierran (hay que volver a entrar).
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Quién puede abrir el panel desde un navegador, separados por coma.
# En producción es OBLIGATORIO: si se deja vacío, ningún navegador entra.
# Ejemplo: https://panel.midominio.com
CORS_ORIGINS=

# Freno contra adivinación de contraseñas. 0 lo desactiva (no recomendado).
LOGIN_MAX_INTENTOS=8
LOGIN_VENTANA_SEGUNDOS=300
LOGIN_BLOQUEO_SEGUNDOS=900

# ── Primer administrador ──────────────────────────────────────────────────────
# Solo se usa cuando la base de datos no tiene NINGÚN usuario todavía.
# Si se deja vacío, el sistema genera una contraseña al azar y la escribe una
# sola vez en el log de arranque. Cámbiala al entrar.
ADMIN_INICIAL_EMAIL=admin
ADMIN_INICIAL_PASSWORD=

# ── WhatsApp ──────────────────────────────────────────────────────────────────
WHATSAPP_API_URL=http://127.0.0.1:3001
# Clave compartida entre el backend y el bot: el MISMO valor en los dos.
# Sin ella, cualquiera que alcance el puerto del bot puede pedir el QR de
# vinculación y enviar mensajes en nombre de la empresa.
# Genera con:  openssl rand -hex 24
WHATSAPP_API_TOKEN=
PHONE_CONTACTO=

# ── Infraestructura ───────────────────────────────────────────────────────────
# Datos del servidor y del túnel. No pongas valores reales en este archivo.
VPS_IP=
SSH_KEY_PATH=/root/.ssh/NOMBRE_DE_LA_LLAVE
SSH_USER=
WG_CONFIG_PATH=/etc/wireguard/wg0.conf
VPS_WG_PUBKEY=

# ── Rutas ─────────────────────────────────────────────────────────────────────
BACKUP_DIR=/backups
MEDIA_DIR=/media

# ── Facturación ───────────────────────────────────────────────────────────────
PRECIO_TV_ADICIONAL=10.0

# ── Datos de la empresa (salen impresos en el recibo) ─────────────────────────
EMPRESA_NOMBRE=WISP
EMPRESA_RUBRO=Ingeniería en Redes y Telecomunicaciones
EMPRESA_RUC=
EMPRESA_DIRECCION=
EMPRESA_CIUDAD=Juliaca - Puno - Perú
EMPRESA_TELEFONOS=
EMPRESA_CORREO=

# ── Nginx ─────────────────────────────────────────────────────────────────────
# Cuál de los archivos de la carpeta nginx/ se monta en el contenedor.
#   nginx.conf             → servidor con IP pública. Exige certificados de
#                            Let's Encrypt en /etc/letsencrypt y NO arranca sin
#                            ellos.
#   nginx.cloudflare.conf  → detrás de Cloudflare Tunnel. Sin certificados
#                            propios: el HTTPS lo pone Cloudflare.
# Si se deja vacío se usa nginx.conf.
NGINX_CONF=

# ── Cloudflare Tunnel (despliegue en oficina) ─────────────────────────────────
# Se obtiene al crear el túnel en el panel Zero Trust de Cloudflare.
CLOUDFLARE_TUNNEL_TOKEN=

# ── Consulta de nombres por DNI/RUC (APIs Perú) ───────────────────────────────
# El token vive SOLO en el servidor: si el móvil llamara directo al proveedor,
# el token viajaría dentro del APK y cualquiera podría extraerlo.
APISPERU_URL=https://dniruc.apisperu.com/api/v1
APISPERU_TOKEN=
CONSULTAS_LIMITE_MENSUAL=1000
CONSULTAS_AVISO_DESDE=950
