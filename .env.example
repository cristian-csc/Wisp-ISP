# ── Base de datos ─────────────────────────────────────────────────────────────
# POSTGRES_* los usa el contenedor postgres; DATABASE_URL lo usa el backend.
# Deben apuntar a los MISMOS valores (usuario/password/db).
POSTGRES_DB=tuxtell_isp
POSTGRES_USER=tuxtell
POSTGRES_PASSWORD=CAMBIA_PASSWORD
DATABASE_URL=postgresql://tuxtell:CAMBIA_PASSWORD@127.0.0.1:5432/tuxtell_isp

# ── Autenticacion JWT (genera con: openssl rand -hex 32) ─────────────────────
SECRET_KEY=CAMBIA_ESTA_CLAVE_EN_PRODUCCION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── WhatsApp ──────────────────────────────────────────────────────────────────
WHATSAPP_API_URL=http://127.0.0.1:3001
PHONE_CONTACTO=990807069

# ── Infraestructura ───────────────────────────────────────────────────────────
VPS_IP=161.132.48.127
SSH_KEY_PATH=/root/.ssh/tuxtell_key
SSH_USER=tuxtell-api
WG_CONFIG_PATH=/etc/wireguard/wg0.conf
VPS_WG_PUBKEY=PUBKEY_DEL_VPS

# ── Rutas ─────────────────────────────────────────────────────────────────────
BACKUP_DIR=/backups
MEDIA_DIR=/media

# ── Facturación ───────────────────────────────────────────────────────────────
PRECIO_TV_ADICIONAL=10.0
