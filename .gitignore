# Entorno — ningún .env sale de esta máquina.
.env
.env.*
!.env.example
*.env
.env.local
.env.production

# Manual privado de seguridad: explica dónde vive cada credencial.
# Aunque no contiene secretos, es un mapa del sistema. Nunca a GitHub.
MANUAL_PRIVADO_SEGURIDAD_WISP-ISP.md
MANUAL_PRIVADO_*.md

# Claves y certificados — nunca, bajo ningún nombre.
*.pem
*.key
*.ppk
*.p12
*.pfx
id_rsa*
id_ed25519*
*.kdbx
wg*.conf
!nginx/*.conf

# Respaldos de la base de datos (llevan datos personales de los clientes).
*.sql
*.sql.gz
*.dump
backups/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
venv/
.venv/

# Node
node_modules/
frontend/dist/
frontend/.vite/

# WhatsApp sesión (no subir — se genera en el VPS)
whatsapp/.wwebjs_auth/
whatsapp/.wwebjs_cache/
whatsapp/node_modules/

